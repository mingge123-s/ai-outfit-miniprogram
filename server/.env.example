# 二选一：配置 OPENAI_API_KEY（OpenAI 兼容网关）或 GEMINI_API_KEY（Google AI Studio）
# 配置了 OPENAI_API_KEY 时默认走 openai 兼容接口（/v1/images/edits）

# 方式 A：OpenAI 兼容生图 API（如 ai.gs88.shop 等代理网关）
OPENAI_API_KEY=sk-your_key_here
OPENAI_BASE_URL=https://ai.gs88.shop
# MODEL_ID=gpt-image-2
# 高质量档在 Cloudflare 网关下易 524 超时，建议 low
# IMAGE_QUALITY=low

# 方式 B：Google Gemini（https://aistudio.google.com/app/apikey）
# GEMINI_API_KEY=your_api_key_here
# MODEL_ID=gemini-2.5-flash-image-preview

# 方式 C：火山方舟 豆包 Seedream（https://console.volcengine.com/ark）
# ARK_API_KEY=your_ark_key_here
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MODEL_ID=doubao-seedream-5-0-pro-260628
# 9:16 竖图，约 236 万像素；适合完整全身构图且处于较低计费档
# ARK_SIZE=1152x2048
# ARK_RESPONSE_FORMAT=url
# ARK_WATERMARK=0
# 后端公开地址，用于今日搭配分析衣柜图片
# PUBLIC_BASE_URL=https://api.mingge.asia/outfit
# 衣柜自动分类复用 ARK_API_KEY，使用低成本豆包视觉模型
# ARK_VISION_MODEL=doubao-seed-2-0-mini-260215
# AUTO_CATEGORY=1
# AUTO_CUTOUT=1

# PROVIDER=ark | openai | gemini（默认按已配置的 key 自动选择，优先 ark）
# 微信登录（小程序后台获取）；不配置时为开发模式（本地调试可直接登录）
# 新旧两个小程序可同时登录：旧号用 WX_APPID，新号用 WX_APPID_2
# WX_APPID=your_appid
# WX_SECRET=your_secret
# WX_APPID_2=your_new_appid
# WX_SECRET_2=your_new_secret

# 微信支付（会员开通，小程序 JSAPI）。MEMBER_PAY_ENABLED=1 才开放购买
# WXPAY_MCHID=商户号
# WXPAY_APIV3_KEY=APIv3密钥(32位)
# WXPAY_SERIAL_NO=商户证书序列号
# WXPAY_PRIVATE_KEY_PATH=/etc/ai-outfit/apiclient_key.pem   ; 商户私钥文件绝对路径
# WXPAY_CERT_PATH=/etc/ai-outfit/apiclient_cert.pem         ; 商户证书(可选，缺省用私钥同路径)
# WXPAY_APPID=默认收款小程序 AppID（缺省用 WX_APPID；新号下单会改用 WX_APPID_2）
# WXPAY_NOTIFY_URL=https://api.mingge.asia/outfit/api/pay/notify
# MEMBER_PAY_ENABLED=1

# 权限额度
FREE_DAILY_LIMIT=3
MEMBER_DAILY_LIMIT=10
FREE_WARDROBE_LIMIT=10
MEMBER_WARDROBE_LIMIT=30
FREE_PERSON_PHOTO_LIMIT=10
MEMBER_PERSON_PHOTO_LIMIT=30
FREE_OUTFIT_LIMIT=20
MEMBER_OUTFIT_LIMIT=40
FREE_SIGNUP_CREDITS=0
CREDITS_PER_GENERATION=1

# 激励视频广告：配置广告位后再开启；默认每人每天最多领取 1 次
REWARDED_AD_ENABLED=0
AD_REWARD_CREDITS=1
AD_DAILY_REWARD_LIMIT=1

# 管理员 HTTP 接口令牌；未配置时关闭管理接口
# ADMIN_TOKEN=请替换为随机长字符串

PORT=3000
