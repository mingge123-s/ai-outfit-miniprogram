page {
  background-color: #fff6f0;
  color: #2b2a33;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Noto Sans SC', sans-serif;
  font-size: 32rpx;
}

.gradient-btn {
  background: linear-gradient(135deg, #ff8a65, #ff5c7a);
  color: #ffffff;
}

button {
  display: flex !important;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 0 24rpx;
  line-height: 1.2 !important;
  text-align: center;
}

button[size='mini'] {
  min-height: 64rpx;
}

button::after {
  border: none;
}
