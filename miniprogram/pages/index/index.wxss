.page {
  padding: 0 32rpx 48rpx;
}

.hero {
  position: relative;
  height: 720rpx;
  margin: 0 -32rpx 28rpx;
  overflow: hidden;
  background: #1b1714;
}
.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}
.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(180deg, rgba(20, 16, 14, 0) 0%, rgba(20, 16, 14, 0.72) 100%);
}
.hero-copy {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 88rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
}
.hero-kicker {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffd6c8;
  letter-spacing: 6rpx;
  margin-bottom: 10rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #fffdfb;
}
.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 248, 244, 0.82);
}
.hero-sticker {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  z-index: 3;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #7a4a12;
  font-size: 22rpx;
  font-weight: 700;
}

.entry {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 28rpx;
  color: #5a2a32;
  background: linear-gradient(120deg, #ffe0d2, #ffd6e4);
  box-shadow: 0 12rpx 28rpx rgba(255, 92, 122, .14);
}
.entry-cover {
  width: 88rpx;
  height: 88rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  background: #fff;
}
.entry-copy { display: flex; flex: 1; flex-direction: column; }
.entry-title { font-size: 30rpx; font-weight: 800; }
.entry-sub { margin-top: 6rpx; font-size: 21rpx; color: #8a5a62; }
.entry-arrow { font-size: 46rpx; color: #ff5c7a; }
