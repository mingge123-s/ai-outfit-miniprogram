.page {
  padding: 0 24rpx calc(170rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  height: 820rpx;
  margin: 0 -24rpx 28rpx;
  overflow: hidden;
  background: #eadfce;
}
.hero-image {
  width: 100%;
  height: 100%;
  display: block;
  filter: brightness(1.03) saturate(0.9) contrast(0.94);
}
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(247, 241, 232, 0.08);
  pointer-events: none;
}
.hero-copy {
  position: absolute;
  left: 36rpx;
  top: 48rpx;
  width: 390rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
}
.hero-settings {
  position: absolute;
  top: 36rpx;
  right: 28rpx;
  z-index: 3;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(63, 50, 42, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 252, 247, 0.76);
}
.hero-settings image {
  width: 30rpx;
  height: 30rpx;
}
.hero-kicker {
  font-size: 34rpx;
  font-weight: 700;
  color: #3f322a;
  letter-spacing: 4rpx;
  margin-bottom: 56rpx;
}
.hero-title {
  font-size: 60rpx;
  line-height: 1.12;
  color: #3f322a;
}
.hero-sub {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #75665c;
}

.entry {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e3d9cc;
  border-radius: 24rpx;
  color: #3f322a;
  background: #fffcf7;
}
.entry-primary {
  min-height: 124rpx;
}
.entry-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #f2eadf;
}
.entry-icon,
.compact-icon {
  width: 38rpx;
  height: 38rpx;
}
.entry-copy { display: flex; flex: 1; flex-direction: column; }
.entry-title { font-size: 29rpx; font-weight: 700; }
.entry-sub { margin-top: 6rpx; font-size: 22rpx; color: #81746a; }
.entry-arrow { width: 34rpx; height: 34rpx; }
.entry-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.entry-compact {
  min-width: 0;
  min-height: 126rpx;
  margin-bottom: 0;
  align-items: flex-start;
}
.entry-compact .entry-copy {
  margin-left: 14rpx;
}
.entry-compact .entry-title {
  font-size: 26rpx;
}
.entry-compact .entry-sub {
  font-size: 20rpx;
}
