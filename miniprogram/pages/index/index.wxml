<view class="page">
  <view class="hero">
    <image class="hero-image" src="/assets/hero-magazine.jpg" mode="aspectFill" />
    <view class="hero-mask" />
    <view class="hero-copy">
      <text class="hero-kicker">时衣集</text>
      <text class="hero-title">打开就知道穿什么</text>
      <text class="hero-sub">上传衣服，一键拼出今日这身</text>
    </view>
    <view class="hero-sticker">今日出片</view>
  </view>

  <view class="entry" bindtap="goToday">
    <image class="entry-cover" src="/assets/look-mint.jpg" mode="aspectFill" />
    <view class="entry-copy">
      <text class="entry-title">今日搭配</text>
      <text class="entry-sub">看天气、选场合，从衣柜直接出一套</text>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <view class="entry" bindtap="goCreate">
    <image class="entry-cover" src="/assets/look-street.jpg" mode="aspectFill" />
    <view class="entry-copy">
      <text class="entry-title">选衣穿搭</text>
      <text class="entry-sub">上传衣服，一键拼出今日这身</text>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <view class="entry" bindtap="goWardrobe">
    <image class="entry-cover" src="/assets/look-cafe.jpg" mode="aspectFill" />
    <view class="entry-copy">
      <text class="entry-title">衣柜展示</text>
      <text class="entry-sub">把衣服收进来，随时调用</text>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <view class="entry" bindtap="goCollection">
    <image class="entry-cover" src="/assets/empty-collection.jpg" mode="aspectFill" />
    <view class="entry-copy">
      <text class="entry-title">模版收藏</text>
      <text class="entry-sub">收藏喜欢的套装，下次直接用</text>
    </view>
    <text class="entry-arrow">›</text>
  </view>
</view>
