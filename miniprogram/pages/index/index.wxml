<view class="page">
  <view class="hero">
    <image class="hero-image" src="/assets/soft-atelier-hero-v2.jpg" mode="aspectFill" />
    <view class="hero-settings" bindtap="goMe">
      <image src="/assets/icons/settings.png" mode="aspectFit" />
    </view>
    <view class="hero-copy">
      <text class="hero-kicker serif-title">时衣集</text>
      <text class="hero-title serif-title">今天穿什么</text>
      <text class="hero-sub">用自己的衣橱，搭出好看的一天</text>
    </view>
  </view>

  <view class="entry entry-primary" bindtap="goToday">
    <view class="entry-icon-wrap">
      <image class="entry-icon" src="/assets/icons/sun.png" mode="aspectFit" />
    </view>
    <view class="entry-copy">
      <text class="entry-title">今日搭配</text>
      <text class="entry-sub">根据天气与场合，从衣柜直接出一套</text>
    </view>
    <image class="entry-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" />
  </view>

  <view class="entry entry-primary" bindtap="goCreate">
    <view class="entry-icon-wrap">
      <image class="entry-icon" src="/assets/icons/sparkles-sage.png" mode="aspectFit" />
    </view>
    <view class="entry-copy">
      <text class="entry-title">选衣穿搭</text>
      <text class="entry-sub">自由搭配单品，打造专属造型</text>
    </view>
    <image class="entry-arrow" src="/assets/icons/chevron-right.png" mode="aspectFit" />
  </view>

  <view class="entry-grid">
    <view class="entry entry-compact" bindtap="goWardrobe">
      <image class="compact-icon" src="/assets/icons/hanger.png" mode="aspectFit" />
      <view class="entry-copy">
        <text class="entry-title">衣柜管理</text>
        <text class="entry-sub">管理我的衣物</text>
      </view>
    </view>
    <view class="entry entry-compact" bindtap="goCollection">
      <image class="compact-icon" src="/assets/icons/heart.png" mode="aspectFit" />
      <view class="entry-copy">
        <text class="entry-title">我的收藏</text>
        <text class="entry-sub">查看收藏套装</text>
      </view>
    </view>
  </view>
</view>
