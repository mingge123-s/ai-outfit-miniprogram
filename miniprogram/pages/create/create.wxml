<view class="page">
  <view class="editor-intro">
    <view class="editor-intro-copy">
      <text class="editor-kicker">LOOK BUILDER</text>
      <text class="editor-title">从衣柜，编辑一套新穿搭</text>
      <text class="editor-sub">按步骤选择单品、场景与动作，随时可以回到上一步调整</text>
    </view>
    <image class="editor-icon" src="/assets/icons/hanger.png" mode="aspectFit" />
  </view>

  <view class="step-section step-first">
    <view class="section-head">
      <view class="section-heading-copy">
        <text class="step-index">01</text>
        <view>
          <text class="section-title">选穿搭单品</text>
          <text class="section-desc">点击空位，从相册或衣柜添加</text>
        </view>
      </view>
      <text class="section-sub">至少 1 件</text>
    </view>

    <view class="grid">
      <view
        wx:for="{{items}}"
        wx:key="key"
        class="item-card dashed {{item.path || item.wardrobeId ? 'filled' : ''}}"
        data-index="{{index}}"
        bindtap="chooseItem"
      >
        <block wx:if="{{item.path || item.wardrobeId}}">
          <image class="item-preview" src="{{item.path || item.imageUrl}}" mode="aspectFill" />
          <view class="remove-btn" catchtap="removeItem" data-index="{{index}}">
            <image class="control-icon" src="/assets/icons/x.png" mode="aspectFit" />
          </view>
          <view class="fav-btn" wx:if="{{item.path}}" catchtap="saveItemToWardrobe" data-index="{{index}}">
            <image class="control-icon" src="/assets/icons/heart.png" mode="aspectFit" />
          </view>
          <view class="item-tag">{{item.label}}{{item.wardrobeId ? ' · 衣柜' : ''}}</view>
        </block>
        <block wx:else>
          <image wx:if="{{item.key === 'pants'}}" class="item-icon" src="/assets/icons/category-bottom.png" mode="aspectFit" />
          <image wx:elif="{{item.key === 'coat'}}" class="item-icon" src="/assets/icons/category-outerwear.png" mode="aspectFit" />
          <image wx:else class="item-icon" src="/assets/icons/category-{{item.key}}.png" mode="aspectFit" />
          <text class="item-label">{{item.label}}</text>
          <text class="item-hint">点击添加</text>
        </block>
      </view>
    </view>
  </view>

  <view class="step-section">
    <view class="section-head">
      <view class="section-heading-copy">
        <text class="step-index">02</text>
        <view>
          <text class="section-title">选背景风格</text>
          <text class="section-desc">确定最终穿搭照的氛围</text>
        </view>
      </view>
      <image class="section-icon" src="/assets/icons/palette.png" mode="aspectFit" />
    </view>

    <view class="chips">
      <view
        wx:for="{{styles}}"
        wx:key="key"
        class="chip {{backgroundStyle === item.key ? 'chip-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="chooseStyle"
      >{{item.label}}</view>
    </view>
    <block wx:if="{{backgroundStyle === 'custom'}}">
      <view class="custom-row">
        <input
          class="custom-input"
          placeholder="描述背景，如：日本樱花街道、安静咖啡馆"
          value="{{customBackground}}"
          bindinput="onCustomBgInput"
        />
        <view class="save-tag-btn" bindtap="saveBgTag">
          <image class="button-icon" src="/assets/icons/plus.png" mode="aspectFit" />
          <text>保存</text>
        </view>
      </view>
      <view class="tag-list" wx:if="{{bgTags.length}}">
        <view
          wx:for="{{bgTags}}"
          wx:key="id"
          class="tag {{customBackground === item.text ? 'tag-active' : ''}}"
          data-text="{{item.text}}"
          bindtap="useBgTag"
        >
          <text class="tag-text">{{item.text}}</text>
          <image class="tag-delete" src="/assets/icons/x.png" mode="aspectFit" catchtap="removeBgTag" data-id="{{item.id}}" />
        </view>
      </view>
      <text class="tags-hint">保存为标签，下次可一键选用（最多 {{bgTagLimit}} 个）</text>
    </block>
  </view>

  <view class="step-section">
    <view class="section-head">
      <view class="section-heading-copy">
        <text class="step-index">03</text>
        <view>
          <text class="section-title">选择模特照片</text>
          <text class="section-desc">不上传也可以直接生成</text>
        </view>
      </view>
      <text class="section-sub muted">可选</text>
    </view>

    <view class="person-editor">
      <view class="person-card dashed {{person || personUrl ? 'filled' : ''}}" bindtap="choosePerson">
        <block wx:if="{{person || personUrl}}">
          <image class="person-preview" src="{{person || personUrl}}" mode="aspectFit" />
          <view class="remove-btn" catchtap="removePerson">
            <image class="control-icon" src="/assets/icons/x.png" mode="aspectFit" />
          </view>
        </block>
        <block wx:else>
          <view class="person-icon-wrap">
            <image class="person-icon" src="/assets/icons/user.png" mode="aspectFit" />
          </view>
          <text class="person-label">上传全身照</text>
          <text class="person-hint">保持自然站姿效果更好</text>
        </block>
      </view>
      <view class="person-aside">
        <text class="person-aside-title">{{person || personUrl ? '已选择模特照' : '使用默认人物'}}</text>
        <text class="person-aside-copy">{{person || personUrl ? '生成时会参考这张照片的人物形象。' : '想让效果更像你，可以上传一张清晰全身照。'}}</text>
        <view class="switch-person-btn" wx:if="{{personCount > 0}}" bindtap="switchPerson">
          <image class="button-icon" src="/assets/icons/refresh.png" mode="aspectFit" />
          <text>换一个形象</text>
        </view>
      </view>
    </view>
  </view>

  <view class="step-section">
    <view class="section-head">
      <view class="section-heading-copy">
        <text class="step-index">04</text>
        <view>
          <text class="section-title">选择人物动作</text>
          <text class="section-desc">让画面更贴近你想要的状态</text>
        </view>
      </view>
      <text class="section-sub muted">可选</text>
    </view>

    <view class="pose-list">
      <view
        wx:for="{{poses}}"
        wx:key="key"
        class="pose-chip {{pose === item.key ? 'pose-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="choosePose"
      >{{item.label}}</view>
    </view>
    <block wx:if="{{pose === 'custom'}}">
      <view class="custom-row">
        <input
          class="custom-input"
          placeholder="描述动作，如：双手插兜回头、靠墙站"
          value="{{customPose}}"
          bindinput="onCustomPoseInput"
        />
        <view class="save-tag-btn" bindtap="savePoseTag">
          <image class="button-icon" src="/assets/icons/plus.png" mode="aspectFit" />
          <text>保存</text>
        </view>
      </view>
      <view class="tag-list" wx:if="{{poseTags.length}}">
        <view
          wx:for="{{poseTags}}"
          wx:key="id"
          class="tag {{customPose === item.text ? 'tag-active' : ''}}"
          data-text="{{item.text}}"
          bindtap="usePoseTag"
        >
          <text class="tag-text">{{item.text}}</text>
          <image class="tag-delete" src="/assets/icons/x.png" mode="aspectFit" catchtap="removePoseTag" data-id="{{item.id}}" />
        </view>
      </view>
      <text class="tags-hint">保存为标签，下次可一键选用（最多 {{poseTagLimit}} 个）</text>
    </block>
  </view>

  <view class="bottom-bar">
    <button
      class="generate-btn {{canGenerate && !loading ? '' : 'disabled'}}"
      disabled="{{!canGenerate || loading}}"
      bindtap="generate"
    >
      <view class="generate-label-row">
        <image wx:if="{{!loading}}" class="cta-icon" src="/assets/icons/sparkles.png" mode="aspectFit" />
        <text class="generate-main">{{loading ? '生成中…' : backgroundStyle === 'custom' && !customBackground ? '请填写自定义背景' : !canGenerate ? '请先上传单品' : '生成穿搭'}}</text>
      </view>
      <text class="generate-sub" wx:if="{{quotaLoaded}}">今日免费 {{remainingFreeToday}}/{{dailyLimit}} · 积分 {{credits}}</text>
    </button>
  </view>

  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-mark">
      <image class="loading-icon" src="/assets/icons/sparkles.png" mode="aspectFit" />
    </view>
    <text class="loading-text">正在提交生成任务…</text>
    <text class="loading-hint">提交后无需等待，可继续使用其他功能</text>
  </view>
</view>
