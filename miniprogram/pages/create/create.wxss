.page {
  padding: 8rpx 32rpx 160rpx;
}

/* 虚线卡片 */
.dashed {
  border: 3rpx dashed #ffb4a2;
  border-radius: 24rpx;
  background: #fff8f4;
  position: relative;
  overflow: hidden;
}
.dashed.filled {
  border-style: solid;
  border-color: #ffd0c4;
  background: #ffffff;
}

/* 模特上传 + 人物动作 两列布局 */
.step34 {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
}
.col-person {
  flex: 0 0 42%;
  display: flex;
  flex-direction: column;
}
.col-pose {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.switch-person-btn {
  margin-top: 12rpx;
  text-align: center;
  padding: 12rpx 0;
  border: 2rpx solid #ffd8cc;
  border-radius: 16rpx;
  background: #ffffff;
  color: #ff5c7a;
  font-size: 22rpx;
}
.person-card {
  width: 100%;
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.pose-list {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 12rpx;
}
.pose-chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #ffe8df;
  color: #8a5a62;
  font-size: 24rpx;
  font-weight: 600;
}
.pose-active {
  background: #ff5c7a;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(92, 124, 141, 0.3);
}
.person-preview {
  width: 100%;
  height: 100%;
}
.person-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.person-icon {
  font-size: 44rpx;
}
.person-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff5c7a;
}
.person-hint {
  font-size: 22rpx;
  color: #777587;
  margin-top: 12rpx;
}

/* 分区标题 */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin: 28rpx 0 16rpx;
}
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a5a62;
  letter-spacing: 2rpx;
}
.section-sub {
  font-size: 24rpx;
  color: #ff5c7a;
}

/* 单品网格 */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.item-card {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.item-preview {
  width: 100%;
  height: 100%;
}
.item-icon {
  font-size: 44rpx;
  margin-bottom: 6rpx;
}
.item-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #2b2a33;
}
.item-hint {
  font-size: 18rpx;
  color: #c08980;
  margin-top: 8rpx;
  white-space: nowrap;
}
.item-tag {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.fav-btn {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 92, 122, 0.88);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 46rpx;
  text-align: center;
  z-index: 2;
}
.remove-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
  z-index: 2;
}

/* 风格标签 */
.more-toggle { margin-top: 20rpx; padding: 18rpx 0; text-align: center; border: 2rpx dashed #d5d5e0; border-radius: 16rpx; background: #fff; color: #8a8a99; font-size: 24rpx; }

.chips {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.custom-bg-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}
.custom-bg {
  flex: 1;
  padding: 18rpx 24rpx;
  border: 2rpx solid #d5d5e0;
  border-radius: 16rpx;
  background: #fff;
  font-size: 26rpx;
}
.save-tag-btn {
  flex: 0 0 auto;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #ff5c7a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}
.bg-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.bg-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eef0f2;
  color: #8a5a62;
  font-size: 22rpx;
}
.bg-tag-active {
  background: #ff5c7a;
  color: #fff;
}
.bg-tag-del {
  font-size: 28rpx;
  line-height: 1;
  opacity: 0.7;
}
.bg-tags-hint {
  display: block;
  margin-top: 12rpx;
  color: #a0a0ad;
  font-size: 22rpx;
}
.chip {
  flex: 0 0 calc((100% - 60rpx) / 6);
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: #ffe8df;
  color: #8a5a62;
  font-size: 22rpx;
  font-weight: 600;
}
.chip-active {
  background: #ff5c7a;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(255, 92, 122, 0.28);
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 28rpx calc(12rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 246, 240, 0) 0%, rgba(255, 246, 240, 0.94) 36%);
  z-index: 50;
}
.generate-btn {
  width: 100%;
  min-height: 80rpx;
  height: auto;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
  padding: 14rpx 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 92, 122, 0.22);
}
.generate-main {
  line-height: 1.2;
}
.generate-sub {
  font-size: 18rpx;
  font-weight: 500;
  opacity: 0.78;
  line-height: 1.2;
}
.generate-btn.disabled,
.generate-btn[disabled] {
  background: linear-gradient(135deg, #ffc3b0, #ff9aad) !important;
  color: #ffffff !important;
  border: none !important;
  opacity: 0.78 !important;
  box-shadow: none !important;
}

/* 加载遮罩 */
.loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(255, 246, 240, 0.95);
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.loading-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 40rpx;
  animation: pulse-ai 2s ease-in-out infinite;
}
.loading-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff5c7a;
}
.loading-hint {
  font-size: 24rpx;
  color: #777587;
  margin-top: 12rpx;
}
@keyframes pulse-ai {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(1.1); }
}
