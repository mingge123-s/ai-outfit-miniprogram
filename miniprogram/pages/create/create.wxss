.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #3F322A;
  background: #F7F1E8;
}

.editor-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0 28rpx;
  border-bottom: 2rpx solid #D9CEC0;
}

.editor-intro-copy {
  display: flex;
  max-width: 570rpx;
  flex-direction: column;
}

.editor-kicker {
  color: #D89A6A;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.editor-title {
  margin-top: 8rpx;
  color: #3F322A;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.editor-sub {
  margin-top: 8rpx;
  color: #7B6E66;
  font-size: 22rpx;
  line-height: 1.55;
}

.editor-icon {
  width: 54rpx;
  height: 54rpx;
  margin-left: 18rpx;
}

.step-section {
  margin-top: 34rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #D9CEC0;
}

.step-section.step-first {
  margin-top: 30rpx;
  padding-top: 0;
  border-top: 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-heading-copy {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
}

.section-heading-copy > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.step-index {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #FFFCF7;
  background: #627A63;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-title {
  color: #3F322A;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.25;
}

.section-desc {
  margin-top: 5rpx;
  color: #8A7D73;
  font-size: 20rpx;
  line-height: 1.35;
}

.section-sub {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 7rpx 12rpx;
  border-radius: 16rpx;
  color: #8B5F3F;
  background: #F5E5D6;
  font-size: 19rpx;
}

.section-sub.muted {
  color: #627A63;
  background: #EEF1E9;
}

.section-icon {
  width: 34rpx;
  height: 34rpx;
}

.dashed {
  position: relative;
  overflow: hidden;
  border: 2rpx dashed #D9CEC0;
  border-radius: 18rpx;
  background: #FFFCF7;
  box-sizing: border-box;
}

.dashed.filled {
  border-style: solid;
  background: #FFFCF7;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.item-card {
  display: flex;
  aspect-ratio: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.item-preview {
  width: 100%;
  height: 100%;
  background: #FFFCF7;
}

.item-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 6rpx;
  opacity: 0.82;
}

.item-label {
  color: #3F322A;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.item-hint {
  margin-top: 5rpx;
  color: #9A8D83;
  font-size: 17rpx;
  white-space: nowrap;
}

.item-tag {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  overflow: hidden;
  padding: 7rpx 10rpx;
  border-radius: 16rpx;
  color: #FFFCF7;
  background: rgba(63, 50, 42, 0.72);
  font-size: 18rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-btn,
.remove-btn {
  position: absolute;
  top: 9rpx;
  z-index: 2;
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(217, 206, 192, 0.8);
  border-radius: 16rpx;
  background: rgba(255, 252, 247, 0.92);
  box-sizing: border-box;
}

.fav-btn {
  left: 9rpx;
}

.remove-btn {
  right: 9rpx;
}

.control-icon {
  width: 24rpx;
  height: 24rpx;
}

.chips,
.pose-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  flex: 0 0 calc((100% - 40rpx) / 5);
  padding: 15rpx 4rpx;
  border: 2rpx solid #D9CEC0;
  border-radius: 16rpx;
  color: #74675F;
  background: #FFFCF7;
  box-sizing: border-box;
  font-size: 21rpx;
  text-align: center;
}

.chip-active,
.pose-active {
  border-color: #627A63 !important;
  color: #FFFCF7 !important;
  background: #627A63 !important;
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.custom-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #D9CEC0;
  border-radius: 18rpx;
  color: #3F322A;
  background: #FFFCF7;
  box-sizing: border-box;
  font-size: 24rpx;
}

.save-tag-btn {
  display: flex;
  height: 80rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #FFFCF7;
  background: #627A63;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 600;
}

.button-icon,
.cta-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.save-tag-btn .button-icon,
.generate-btn .cta-icon {
  filter: brightness(0) invert(1);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 15rpx;
}

.tag {
  display: flex;
  max-width: 100%;
  align-items: center;
  gap: 8rpx;
  padding: 9rpx 11rpx 9rpx 15rpx;
  border: 2rpx solid #D9CEC0;
  border-radius: 16rpx;
  color: #6F625A;
  background: #FFFCF7;
  box-sizing: border-box;
  font-size: 20rpx;
}

.tag-active {
  border-color: #627A63;
  color: #627A63;
  background: #EEF1E9;
}

.tag-text {
  max-width: 500rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-delete {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.62;
}

.tags-hint {
  display: block;
  margin-top: 11rpx;
  color: #9A8D83;
  font-size: 19rpx;
  line-height: 1.5;
}

.person-editor {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
}

.person-card {
  display: flex;
  width: 250rpx;
  height: 284rpx;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.person-preview {
  width: 100%;
  height: 100%;
  background: #FFFCF7;
}

.person-icon-wrap {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  background: #EEF1E9;
}

.person-icon {
  width: 38rpx;
  height: 38rpx;
}

.person-label {
  color: #3F322A;
  font-size: 23rpx;
  font-weight: 600;
}

.person-hint {
  margin-top: 8rpx;
  color: #9A8D83;
  font-size: 18rpx;
}

.person-aside {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  padding: 22rpx;
  border: 2rpx solid #D9CEC0;
  border-radius: 18rpx;
  background: #FFFCF7;
  box-sizing: border-box;
}

.person-aside-title {
  color: #3F322A;
  font-size: 25rpx;
  font-weight: 650;
}

.person-aside-copy {
  margin-top: 10rpx;
  color: #7B6E66;
  font-size: 21rpx;
  line-height: 1.55;
}

.switch-person-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 14rpx 12rpx;
  border: 2rpx solid #627A63;
  border-radius: 16rpx;
  color: #526753;
  background: #FFFCF7;
  font-size: 21rpx;
  font-weight: 600;
}

.pose-chip {
  padding: 14rpx 20rpx;
  border: 2rpx solid #D9CEC0;
  border-radius: 16rpx;
  color: #74675F;
  background: #FFFCF7;
  font-size: 22rpx;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  padding: 28rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(247, 241, 232, 0.98);
}

.generate-btn {
  display: flex;
  width: 100%;
  min-height: 92rpx;
  height: auto;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  color: #FFFCF7;
  background: #627A63;
  box-shadow: 0 8rpx 20rpx rgba(63, 50, 42, 0.11);
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 650;
}

.generate-label-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
}

.generate-main {
  line-height: 1.2;
}

.generate-sub {
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.2;
  opacity: 0.78;
}

.generate-btn.disabled,
.generate-btn[disabled] {
  color: #7B6E66 !important;
  background: #D9CEC0 !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

.loading-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(247, 241, 232, 0.97);
}

.loading-mark {
  display: flex;
  width: 132rpx;
  height: 132rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
  background: #627A63;
  animation: pulse-ai 1.8s ease-in-out infinite;
}

.loading-icon {
  width: 58rpx;
  height: 58rpx;
  filter: brightness(0) invert(1);
}

.loading-text {
  color: #3F322A;
  font-size: 30rpx;
  font-weight: 650;
}

.loading-hint {
  margin-top: 10rpx;
  color: #8A7D73;
  font-size: 22rpx;
}

@keyframes pulse-ai {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.72; transform: scale(1.05); }
}
