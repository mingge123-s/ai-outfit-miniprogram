.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx 260rpx;
  background: #f7f2ea;
  color: #3a2c25;
}

.hero-wrap {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #ded4c7;
  border-radius: 20rpx;
  background: #eee8de;
}

.hero-image {
  display: block;
  width: 100%;
}

.float-label {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 9rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  background: rgba(255, 252, 247, 0.88);
  color: #53614e;
  font-size: 21rpx;
  font-weight: 600;
}

.label-icon {
  width: 25rpx;
  height: 25rpx;
}

.pending-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 650rpx;
  box-sizing: border-box;
  padding: 90rpx 44rpx;
  border: 1rpx solid #e0d6ca;
  border-radius: 20rpx;
  background: #fffcf7;
  text-align: center;
  flex-direction: column;
}

.pending-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 126rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid #cfd7c8;
  border-radius: 50%;
  background: #e8ece4;
}

.pending-symbol-icon {
  width: 54rpx;
  height: 54rpx;
  opacity: 0.74;
}

.pending-dreaming {
  animation: pulse-ai 2.2s ease-in-out infinite;
}

@keyframes pulse-ai {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.06); }
}

.pending-title {
  margin-bottom: 14rpx;
  color: #53614e;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 34rpx;
  font-weight: 600;
}

.pending-sub {
  margin-top: 7rpx;
  color: #918277;
  font-size: 23rpx;
  line-height: 1.55;
}

.failed-symbol {
  border-color: #e7cfc1;
  background: #f2e1d7;
}

.failed-title {
  color: #815844;
}

.items-section {
  padding-top: 38rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  color: #3a2c25;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 34rpx;
  font-weight: 600;
}

.section-sub {
  margin-bottom: 4rpx;
  color: #918277;
  font-size: 21rpx;
}

.items-scroll {
  width: 100%;
  white-space: nowrap;
}

.item-cell {
  display: inline-flex;
  align-items: center;
  width: 178rpx;
  margin-right: 14rpx;
  vertical-align: top;
  flex-direction: column;
}

.item-thumb-wrap {
  width: 178rpx;
  height: 178rpx;
  box-sizing: border-box;
  margin-bottom: 10rpx;
  overflow: hidden;
  border: 1rpx solid #e0d6ca;
  border-radius: 18rpx;
  background: #fffcf7;
}

.item-thumb {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 8rpx;
}

.item-name {
  max-width: 170rpx;
  overflow: hidden;
  color: #66564c;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  box-sizing: border-box;
  padding: 20rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ddd3c7;
  background: rgba(247, 242, 234, 0.96);
}

.action-row {
  display: flex;
  gap: 14rpx;
}

.action-row + .action-row {
  margin-top: 12rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 78rpx;
  min-height: 78rpx !important;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid transparent;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.button-icon {
  flex-shrink: 0;
  width: 29rpx;
  height: 29rpx;
  margin-right: 9rpx;
  opacity: 0.7;
}

.button-icon-light {
  filter: invert(1);
  opacity: 0.92;
}

.save-btn {
  background: #71856b;
  color: #ffffff;
}

.collect-btn {
  border-color: #9daa97;
  background: #fffcf7;
  color: #586653;
}

.regen-btn {
  border-color: #e2c3b1;
  background: #edd9cc;
  color: #744f3e;
}

.edit-btn {
  border-color: #d7cec2;
  background: transparent;
  color: #594a41;
}

.action-btn[disabled] {
  border-color: #d8d1c8;
  background: #e6e0d7;
  color: #9d9389;
}
