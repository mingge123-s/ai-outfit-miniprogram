.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(170rpx + env(safe-area-inset-bottom));
  background: #f7f2ea;
  color: #3a2c25;
}

.page-status {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 48rpx 36rpx;
  border: 2rpx solid #e5ddd2;
  border-radius: 20rpx;
  background: #fffcf7;
  text-align: center;
}

.page-status-icon {
  width: 58rpx;
  height: 58rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: #e8eee5;
}

.page-status-title,
.page-status-copy {
  display: block;
}

.page-status-title {
  margin-top: 24rpx;
  font-family: Georgia, 'Songti SC', 'STSong', serif;
  font-size: 30rpx;
  font-weight: 600;
}

.page-status-copy {
  margin-top: 10rpx;
  color: #8c7b6d;
  font-size: 21rpx;
}

.page-status-error .page-status-icon {
  background: #f4e6d8;
}

.profile {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx 28rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  border: 1rpx solid #d9d0c4;
  border-radius: 50%;
  background: #e6e8df;
}

.avatar-icon {
  width: 43rpx;
  height: 43rpx;
  opacity: 0.72;
}

.info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.name {
  color: #3a2c25;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 32rpx;
  font-weight: 600;
}

.sub {
  margin-top: 6rpx;
  overflow: hidden;
  color: #93857a;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border: 1rpx solid #cfd6c8;
  border-radius: 999rpx;
  background: #edf0e8;
  color: #66745f;
  font-size: 20rpx;
}

.level-member {
  border-color: #e6cf9f;
  background: #f7ecd4;
  color: #8d6625;
}

.stats {
  display: flex;
  padding: 22rpx 0;
  border-top: 1rpx solid #e2d8cc;
  border-bottom: 1rpx solid #e2d8cc;
}

.stat {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.num {
  color: #66745f;
  font-family: Georgia, serif;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.2;
}

.label {
  margin-top: 7rpx;
  color: #93857a;
  font-size: 19rpx;
  white-space: nowrap;
}

.divider {
  width: 1rpx;
  height: 54rpx;
  background: #e3d9cd;
}

.studio-section {
  padding: 44rpx 0 42rpx;
  border-bottom: 1rpx solid #e2d8cc;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-copy {
  display: flex;
  flex-direction: column;
}

.section-title {
  color: #3a2c25;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 35rpx;
  font-weight: 600;
}

.section-count {
  margin-bottom: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e9ebe3;
  color: #66745f;
  font-size: 20rpx;
}

.section-note {
  display: block;
  margin-top: 8rpx;
  color: #93857a;
  font-size: 21rpx;
}

.photos-scroll {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.photo {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 214rpx;
  height: 292rpx;
  margin-right: 16rpx;
  overflow: hidden;
  border: 1rpx solid #dfd5c8;
  border-radius: 18rpx;
  background: #eee8de;
  vertical-align: top;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del,
.history-del {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(52, 42, 35, 0.68);
}

.remove-icon {
  width: 22rpx;
  height: 22rpx;
  filter: invert(1);
}

.photo-add {
  box-sizing: border-box;
  border: 2rpx dashed #bdb2a5;
  background: rgba(255, 252, 247, 0.46);
  flex-direction: column;
}

.photo-plus {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.55;
}

.photo-add-text {
  margin-top: 12rpx;
  color: #86776c;
  font-size: 21rpx;
}

.history-row {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.history-item {
  position: relative;
  display: inline-block;
  flex-shrink: 0;
  width: 320rpx;
  height: 480rpx;
  margin-right: 18rpx;
  overflow: hidden;
  border: 1rpx solid #ded4c7;
  border-radius: 18rpx;
  background: #e9e7df;
  vertical-align: top;
}

.history-img {
  width: 100%;
  height: 100%;
  animation: history-reveal 0.8s ease-out;
}

@keyframes history-reveal {
  0% { opacity: 0.45; transform: scale(1.025); filter: blur(18rpx); }
  100% { opacity: 1; transform: scale(1); filter: blur(0); }
}

.history-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #7b6f65;
  font-size: 23rpx;
  flex-direction: column;
}

.history-generating {
  background: #ebe5dc;
}

.history-placeholder-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 16rpx;
  opacity: 0.66;
}

.history-failed-icon {
  opacity: 0.48;
}

.history-status {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  padding: 6rpx 13rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 999rpx;
  background: rgba(75, 91, 70, 0.82);
  color: #ffffff;
  font-size: 19rpx;
}

.history-status.failed {
  background: rgba(114, 77, 66, 0.84);
}

.history-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 180rpx;
  margin-top: 22rpx;
  border: 1rpx dashed #cfc4b7;
  border-radius: 18rpx;
  color: #93857a;
  font-size: 22rpx;
  flex-direction: column;
}

.history-empty-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 10rpx;
  opacity: 0.45;
}

.account-section {
  padding: 42rpx 0 12rpx;
}

.account-title {
  display: block;
  margin: 0 4rpx 18rpx;
  color: #3a2c25;
  font-family: Georgia, 'Songti SC', serif;
  font-size: 31rpx;
  font-weight: 600;
}

.benefits {
  overflow: hidden;
  border-top: 1rpx solid #e1d7cb;
  border-bottom: 1rpx solid #e1d7cb;
}

.benefit-row {
  display: flex;
  align-items: center;
  min-height: 122rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #e8dfd4;
}

.benefit-row:last-child {
  border-bottom: 0;
}

.benefit-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 62rpx;
  height: 62rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  background: #e5ebe1;
}

.benefit-icon-peach {
  background: #f2dfd2;
}

.benefit-icon-gold {
  background: #f1e4c9;
}

.benefit-icon {
  width: 31rpx;
  height: 31rpx;
  opacity: 0.72;
}

.benefit-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.benefit-title {
  color: #43342c;
  font-size: 26rpx;
  font-weight: 600;
}

.benefit-sub {
  margin-top: 6rpx;
  color: #93857a;
  font-size: 19rpx;
  line-height: 1.45;
}

.benefit-btn {
  flex-shrink: 0;
  min-width: 82rpx;
  margin-left: 14rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: #71856b;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
}

.benefit-btn-peach {
  background: #d99a7b;
}

.benefit-btn-gold {
  background: #a8864c;
}

.menu {
  margin-top: 32rpx;
  border-top: 1rpx solid #e1d7cb;
  border-bottom: 1rpx solid #e1d7cb;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #e8dfd4;
  color: #4a3b32;
  font-size: 25rpx;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-label {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 16rpx;
  opacity: 0.64;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.42;
}
